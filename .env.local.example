# Copy to .env.local (already gitignored) - never commit real values here.
#
# "portfolio" (default) - generic placeholder content, safe for the public repo.
# "pitch" - real client content, read only from the vars below, for local
#           pitch-mode builds only. Every var here is optional: if unset,
#           the app silently falls back to the generic portfolio content.
NEXT_PUBLIC_SITE_MODE=portfolio

# --- Pitch-mode content overrides (all optional, all gitignored) ----------
NEXT_PUBLIC_PITCH_BRAND_NAME=
NEXT_PUBLIC_PITCH_EYEBROW=
NEXT_PUBLIC_PITCH_TAGLINE=
NEXT_PUBLIC_PITCH_HERO_LEAD=
# JSON array of {"value":"...","label":"..."} objects, e.g.
# NEXT_PUBLIC_PITCH_CREDENTIALS_JSON=[{"value":"PhD","label":"Delhi University"}]
NEXT_PUBLIC_PITCH_CREDENTIALS_JSON=
# Pipe-separated ("|") list of paragraphs / bullet items
NEXT_PUBLIC_PITCH_ABOUT_BIO=
NEXT_PUBLIC_PITCH_ABOUT_HIGHLIGHTS=
NEXT_PUBLIC_PITCH_ADDRESS=
NEXT_PUBLIC_PITCH_PHONE_DISPLAY=
# Digits only, E.164 without "+", e.g. 919999999999
NEXT_PUBLIC_PITCH_WHATSAPP_NUMBER=
NEXT_PUBLIC_PITCH_PRACTO_CONNECTED=false
